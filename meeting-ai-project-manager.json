{
  "name": "AI Agent for Project Management",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "meeting-processed",
        "options": {}
      },
      "id": "a1b2c3d4-0001-4000-8000-000000000001",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 300],
      "webhookId": "meeting-processed-webhook"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.fireflies.ai/graphql",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Content-Type", "value": "application/json" },
            { "name": "Authorization", "value": "Bearer YOUR_FIREFLIES_API_KEY" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ query: 'query Transcript($transcriptId: String!) { transcript(id: $transcriptId) { title date participants summary { overview action_items } } }', variables: { transcriptId: $json.body.meetingId } }) }}",
        "options": {}
      },
      "id": "a1b2c3d4-0002-4000-8000-000000000002",
      "name": "Get Meeting Content",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [260, 300]
    },
    {
      "parameters": {
        "content": "Replace API key for Fireflies",
        "height": 80,
        "width": 220
      },
      "id": "a1b2c3d4-0003-4000-8000-000000000003",
      "name": "Sticky Note",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [240, 160]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Meeting data (JSON):\n{{ JSON.stringify($json.data.transcript) }}",
        "options": {
          "systemMessage": "You are an AI project manager. From the meeting data: 1) Create one task per action item using the Create Tasks tool (name, details, due date in YYYY-MM-DD; if no date is given use 7 days from today). 2) Send the client ONE email using Notify Client About Tasks summarising the tasks and owners. 3) If a follow-up meeting is mentioned, use Create Event to schedule it (ISO 8601 start/end). Never invent information that is not in the meeting data. Finish with a short summary of what you did."
        }
      },
      "id": "a1b2c3d4-0004-4000-8000-000000000004",
      "name": "AI Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [540, 300]
    },
    {
      "parameters": {
        "model": {
          "__rl": true,
          "value": "gpt-4o-mini",
          "mode": "list",
          "cachedResultName": "gpt-4o-mini"
        },
        "options": { "temperature": 0.2 }
      },
      "id": "a1b2c3d4-0005-4000-8000-000000000005",
      "name": "OpenAI Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.2,
      "position": [420, 560],
      "credentials": {
        "openAiApi": { "id": "REPLACE", "name": "OpenAI account" }
      }
    },
    {
      "parameters": {
        "operation": "create",
        "base": { "__rl": true, "mode": "id", "value": "YOUR_AIRTABLE_BASE_ID" },
        "table": { "__rl": true, "mode": "id", "value": "YOUR_AIRTABLE_TABLE_ID" },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "Name": "={{ $fromAI('task_name', 'Short task title', 'string') }}",
            "Notes": "={{ $fromAI('task_details', 'Task description and owner', 'string') }}",
            "Due Date": "={{ $fromAI('due_date', 'Due date YYYY-MM-DD', 'string') }}"
          },
          "matchingColumns": [],
          "schema": []
        },
        "options": {}
      },
      "id": "a1b2c3d4-0006-4000-8000-000000000006",
      "name": "Create Tasks",
      "type": "n8n-nodes-base.airtableTool",
      "typeVersion": 2.1,
      "position": [640, 560],
      "credentials": {
        "airtableTokenApi": { "id": "REPLACE", "name": "Airtable account" }
      }
    },
    {
      "parameters": {
        "sendTo": "={{ $fromAI('client_email', 'Client email address', 'string') }}",
        "subject": "={{ $fromAI('subject', 'Email subject', 'string') }}",
        "message": "={{ $fromAI('message', 'Email body summarising tasks, owners and due dates', 'string') }}",
        "options": {}
      },
      "id": "a1b2c3d4-0007-4000-8000-000000000007",
      "name": "Notify Client About Tasks",
      "type": "n8n-nodes-base.gmailTool",
      "typeVersion": 2.1,
      "position": [860, 560],
      "credentials": {
        "gmailOAuth2": { "id": "REPLACE", "name": "Gmail account" }
      }
    },
    {
      "parameters": {
        "calendar": { "__rl": true, "mode": "id", "value": "primary" },
        "start": "={{ $fromAI('start_time', 'Event start, ISO 8601', 'string') }}",
        "end": "={{ $fromAI('end_time', 'Event end, ISO 8601', 'string') }}",
        "additionalFields": {
          "summary": "={{ $fromAI('event_title', 'Event title', 'string') }}"
        }
      },
      "id": "a1b2c3d4-0008-4000-8000-000000000008",
      "name": "Create Event",
      "type": "n8n-nodes-base.googleCalendarTool",
      "typeVersion": 1.3,
      "position": [1080, 560],
      "credentials": {
        "googleCalendarOAuth2Api": { "id": "REPLACE", "name": "Google Calendar account" }
      }
    }
  ],
  "connections": {
    "Webhook": {
      "main": [[{ "node": "Get Meeting Content", "type": "main", "index": 0 }]]
    },
    "Get Meeting Content": {
      "main": [[{ "node": "AI Agent", "type": "main", "index": 0 }]]
    },
    "OpenAI Chat Model": {
      "ai_languageModel": [[{ "node": "AI Agent", "type": "ai_languageModel", "index": 0 }]]
    },
    "Create Tasks": {
      "ai_tool": [[{ "node": "AI Agent", "type": "ai_tool", "index": 0 }]]
    },
    "Notify Client About Tasks": {
      "ai_tool": [[{ "node": "AI Agent", "type": "ai_tool", "index": 0 }]]
    },
    "Create Event": {
      "ai_tool": [[{ "node": "AI Agent", "type": "ai_tool", "index": 0 }]]
    }
  },
  "pinData": {},
  "settings": { "executionOrder": "v1" }
}
